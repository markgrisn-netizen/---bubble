# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Settings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional API key for Groq API (Llama 4 Scout/Maverick, Llama 3.3, Qwen).
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# OPENROUTER_API_KEY: Optional API key for OpenRouter API (free & paid multimodal/text models).
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# CLOUDFLARE_API_TOKEN & CLOUDFLARE_ACCOUNT_ID: Optional credentials for Cloudflare Workers AI.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_BASE_URL=""

# DEEPSEEK_API_KEY: Optional server-side API key for DeepSeek comic translation (deepseek-chat / deepseek-reasoner).
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# QWEN_API_KEY (or DASHSCOPE_API_KEY): Optional server-side API key for Qwen Studio / Alibaba DashScope.
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
